{
  "name": "sistema-administrativo-epic",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-no-handrolled-css.mjs --src . --budget 200",
    "check:size": "node scripts/check-component-size.mjs --src . --warn 200 --fail 300",
    "check:layout": "node scripts/check-consistent-container.mjs --src .",
    "check:guardrails": "npm run check:css && npm run check:size && npm run check:layout",
    "check:staged": "npm run check:guardrails && biome check .",
    "check:fast": "npm run check:staged && npm run typecheck",
    "check:full": "npm run check:fast && npm run build",
    "import:seed": "node scripts/import/build-seed.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sistema-administrativo-epic --local",
    "db:seed": "wrangler d1 execute sistema-administrativo-epic --local --file data/seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "db:sql": "wrangler d1 execute sistema-administrativo-epic --local --command",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:user": "node scripts/create-user.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@opennextjs/cloudflare": "^1.20.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
